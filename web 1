<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f2e39b">
    <meta name="description" content="BULLS ENTERPRISE: shop thoughtfully designed pens and Bulls apparel in one place.">
    <title>BULLS ENTERPRISE — Pens, apparel & everyday goods</title>
    <style>
        :root {
            color-scheme: light;
            --ink: #17241f;
            --muted: #737b73;
            --paper: #f6f5f0;
            --green: #75631f;
            --green-dark: #393620;
            --brand-yellow: #f2e39b;
            --brand-yellow-light: #fbf5d6;
            --nav-blue: #377aa4;
            --nav-blue-dark: #245c80;
            --line: #e4e5dc;
            --editorial: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
            --button-shadow: 0 7px 18px rgba(57,54,32,.14);
            --button-shadow-hover: 0 12px 25px rgba(57,54,32,.22);
            --pen-color: #e4ce69;
            --pen-dark: #a68e37;
            --pen-light: #f5e9a6;
        }

        * { box-sizing: border-box; }

        html { scroll-behavior: smooth; }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: "Segoe UI", Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        button, a { font: inherit; }
        button { color: inherit; }
        a { color: inherit; text-decoration: none; }
        button, a { -webkit-tap-highlight-color: transparent; }
        button:focus-visible, a:focus-visible { outline: 3px solid #9a7927; outline-offset: 3px; }

        .announcement {
            min-height: 37px;
            padding: 5px 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            background: var(--brand-yellow);
            color: var(--ink);
            text-align: center;
            font-size: 10px;
            letter-spacing: .04em;
        }

        .announcement strong { font-weight: 650; }
        .announcement-copy { min-width: 250px; }
        .announcement-link { color: var(--green-dark); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
        .announcement-control {
            width: 23px;
            height: 23px;
            padding: 0;
            border: 1px solid rgba(23,36,31,.22);
            border-radius: 50%;
            background: transparent;
            color: var(--ink);
            cursor: pointer;
            line-height: 1;
        }
        .announcement-control:hover { background: rgba(255,255,255,.45); }

        .site-header {
            position: sticky;
            top: 0;
            z-index: 4;
            min-height: 82px;
            padding: 0 clamp(22px, 7.3%, 110px);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 32px;
            background: rgba(246,245,240,.97);
            border-bottom: 1px solid rgba(23, 36, 31, .08);
            box-shadow: 0 4px 15px rgba(23,36,31,.035);
            backdrop-filter: blur(12px);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 17px;
            font-weight: 700;
            letter-spacing: .075em;
            white-space: nowrap;
        }

        .brand-mark { width: 39px; height: 34px; flex: 0 0 auto; color: var(--green-dark); }
        .brand span { color: var(--green); }

        .nav-links {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: clamp(20px, 3.2vw, 48px);
            color: #566159;
            font-size: 13px;
        }

        .nav-links a:not(.about-link) {
            padding: 10px 15px;
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 999px;
            background: var(--nav-blue);
            box-shadow: 0 5px 13px rgba(34,83,115,.16);
            color: white;
            transition: background .2s, box-shadow .2s, transform .2s;
        }
        .nav-links a:not(.about-link):hover {
            background: var(--nav-blue-dark);
            box-shadow: 0 8px 18px rgba(34,83,115,.25);
            color: white;
            transform: translateY(-2px);
        }
        .nav-links .about-link {
            padding: 10px 16px;
            border: 1px solid rgba(57,54,32,.32);
            background: var(--brand-yellow);
            color: var(--ink);
            font-size: 11px;
            font-weight: 650;
            transition: background .2s, transform .2s;
        }
        .nav-links .about-link:hover { background: #e8d47a; color: var(--ink); transform: translateY(-1px); }

        .cart-button {
            display: inline-flex;
            gap: 9px;
            align-items: center;
            padding: 9px 13px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: transparent;
            cursor: pointer;
            font-size: 12px;
        }

        .cart-count {
            display: grid;
            width: 20px;
            height: 20px;
            place-items: center;
            border-radius: 50%;
            background: var(--brand-yellow);
            color: var(--ink);
            font-size: 10px;
        }

        .hero {
            position: relative;
            min-height: 640px;
            padding: 64px 10% 70px;
            display: grid;
            grid-template-columns: 1fr 1.05fr;
            align-items: center;
            gap: 36px;
            overflow: hidden;
            background:
                linear-gradient(90deg, rgba(249,247,233,.94) 0%, rgba(249,247,233,.88) 43%, rgba(249,247,233,.42) 100%),
                url("https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=2200&q=85") center 52% / cover no-repeat;
        }

        .hero-copy { max-width: 470px; }

        .eyebrow {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--green);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .17em;
            text-transform: uppercase;
        }

        .eyebrow::before {
            width: 24px;
            height: 1px;
            background: currentColor;
            content: "";
        }

        h1, h2, p { margin-top: 0; }

        h1 {
            margin: 20px 0 18px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(52px, 6.1vw, 82px);
            font-weight: 400;
            letter-spacing: -.065em;
            line-height: .98;
        }

        h1 em { color: var(--green); font-weight: 400; }

        .hero-description {
            max-width: 390px;
            margin-bottom: 25px;
            color: var(--muted);
            font-size: 15px;
            line-height: 1.8;
        }

        .hero-rating {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 27px;
            color: #8a6c38;
            font-size: 12px;
        }

        .stars { letter-spacing: 2px; }
        .rating-caption { color: var(--muted); }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .primary-button {
            min-height: 50px;
            padding: 0 23px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            border: 0;
            border-radius: 3px;
            background: var(--brand-yellow);
            color: var(--ink);
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            transition: background .2s, transform .2s;
        }

        .primary-button:hover { background: #e8d47a; transform: translateY(-1px); }
        .price { font-family: Georgia, "Times New Roman", serif; font-size: 20px; }
        .price small { color: var(--muted); font: 11px "Segoe UI", Arial, sans-serif; }

        .hero-art {
            position: relative;
            min-height: 400px;
            display: grid;
            place-items: center;
        }

        .art-circle {
            position: absolute;
            width: min(390px, 90%);
            aspect-ratio: 1;
            border-radius: 50%;
            background: #f4edce;
        }

        .art-circle::after {
            position: absolute;
            inset: 18px;
            border: 1px solid rgba(46, 89, 71, .12);
            border-radius: inherit;
            content: "";
        }

        .art-caption {
            position: absolute;
            right: 3%;
            bottom: 6%;
            z-index: 2;
            padding: 14px 18px;
            border: 1px solid rgba(23, 36, 31, .08);
            background: rgba(246, 245, 240, .91);
            color: var(--green);
            font-family: Georgia, "Times New Roman", serif;
            font-size: 14px;
            font-style: italic;
        }

        .pen {
            --pen-color: #e4ce69;
            --pen-dark: #a68e37;
            --pen-light: #f5e9a6;
            position: relative;
            z-index: 1;
            width: 356px;
            height: 40px;
            border: 1px solid rgba(16, 29, 22, .2);
            border-radius: 22px 18px 18px 22px;
            background: linear-gradient(180deg, var(--pen-light) 0%, var(--pen-color) 25%, var(--pen-color) 70%, var(--pen-dark) 100%);
            box-shadow: 0 16px 27px rgba(27, 44, 34, .18), inset 0 1px 2px rgba(255,255,255,.55);
            transform: rotate(-35deg);
            transition: background .25s;
        }

        .pen::before {
            position: absolute;
            top: 3px;
            left: 28px;
            width: 229px;
            height: 4px;
            border-radius: 50%;
            background: rgba(255,255,255,.26);
            content: "";
        }

        .pen-cap {
            position: absolute;
            top: -1px;
            left: 17px;
            width: 32px;
            height: 40px;
            border-right: 1px solid rgba(0,0,0,.14);
            border-left: 1px solid rgba(255,255,255,.16);
            background: linear-gradient(90deg, var(--pen-dark), var(--pen-color) 28%, var(--pen-light) 48%, var(--pen-color) 75%, var(--pen-dark));
        }

        .pen-band {
            position: absolute;
            top: -1px;
            right: 55px;
            width: 7px;
            height: 40px;
            border-right: 1px solid #c5a960;
            border-left: 1px solid #e1d09e;
            background: linear-gradient(90deg, #a98d4f, #f1e0a9, #b4985a);
        }

        .pen-clip {
            position: absolute;
            top: -12px;
            left: 21px;
            width: 12px;
            height: 41px;
            border: 2px solid #bca56e;
            border-bottom: 0;
            border-radius: 8px 8px 0 0;
            transform: rotate(-8deg);
        }

        .pen-tip {
            position: absolute;
            top: 9px;
            right: -25px;
            width: 26px;
            height: 20px;
            background: linear-gradient(180deg, #d6d3c8, #a9a69c 55%, #777a72);
            clip-path: polygon(0 0, 100% 50%, 0 100%);
        }

        .pen-nib {
            position: absolute;
            top: 17px;
            right: -36px;
            width: 12px;
            height: 6px;
            border-radius: 50%;
            background: #555b54;
            clip-path: polygon(0 0, 100% 50%, 0 100%);
        }

        .art-spark {
            position: absolute;
            color: #a38a55;
            font-family: Georgia, serif;
            font-size: 32px;
        }

        .spark-one { top: 15%; left: 16%; }
        .spark-two { right: 11%; top: 29%; font-size: 20px; }

        .benefits {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            padding: 24px 10%;
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
        }

        .benefit {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: #566159;
            font-size: 12px;
        }

        .benefit + .benefit { border-left: 1px solid var(--line); }
        .benefit-icon { color: var(--green); font-family: Georgia, serif; font-size: 20px; }

        .our-story-scene {
            position: relative;
            min-height: 560px;
            display: grid;
            align-items: center;
            overflow: hidden;
            isolation: isolate;
            background: #39483e;
        }

        .story-backdrop {
            position: absolute;
            z-index: -2;
            inset: -12% 0;
            overflow: hidden;
            transform: translate3d(0, var(--story-parallax, 0px), 0);
            will-change: transform;
        }

        .story-backdrop img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center 54%;
            transform: scale(1.08);
        }

        .our-story-scene::before {
            position: absolute;
            z-index: -1;
            inset: 0;
            background: linear-gradient(90deg, rgba(20,28,25,.78), rgba(20,28,25,.38) 65%, rgba(20,28,25,.2));
            content: "";
        }

        .our-story-content {
            width: min(1120px, 100%);
            margin: auto;
            padding: 100px 8%;
            color: white;
        }

        .our-story-kicker {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #f2e39b;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .22em;
            text-transform: uppercase;
        }

        .our-story-kicker::before { width: 29px; height: 1px; background: currentColor; content: ""; }
        .our-story-content h2 {
            max-width: 700px;
            margin: 22px 0;
            font-size: clamp(48px, 7vw, 86px);
            letter-spacing: -.06em;
            line-height: .96;
        }

        .our-story-content h2 em { color: #f2e39b; font-weight: 400; }
        .our-story-copy { max-width: 510px; color: rgba(255,255,255,.88); font-size: 14px; line-height: 1.9; }
        .our-story-copy strong { color: white; font-weight: 650; }
        .our-story-link {
            min-height: 46px;
            margin-top: 12px;
            padding: 0 20px;
            display: inline-flex;
            align-items: center;
            gap: 20px;
            border: 1px solid #f2e39b;
            border-radius: 999px;
            background: #f2e39b;
            box-shadow: 0 8px 20px rgba(0,0,0,.2);
            color: #24231f;
            font-size: 11px;
            transition: transform .2s, box-shadow .2s, background .2s;
        }

        .our-story-link:hover { transform: translateY(-2px); background: #e8d47a; box-shadow: 0 12px 25px rgba(0,0,0,.28); }

        .smiles {
            padding: 82px 8% 78px;
            overflow: hidden;
            background: #fbfaf6;
        }

        .smiles-heading {
            max-width: 550px;
            margin: 0 auto 34px;
            text-align: center;
        }

        .smiles-heading .eyebrow { justify-content: center; }
        .smiles-heading h2 { margin: 16px 0 11px; }
        .smiles-heading p { margin-bottom: 0; color: var(--muted); font-size: 13px; line-height: 1.7; }

        .smiles-grid {
            max-width: 1140px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            align-items: start;
            gap: 20px;
        }

        .smile-card {
            position: relative;
            margin: 0;
            padding: 10px 10px 16px;
            border: 1px solid #e8e7df;
            background: white;
            box-shadow: 0 10px 28px rgba(23,36,31,.055);
        }

        .smile-card:nth-child(2) { margin-top: 24px; }

        .smile-photo {
            width: 100%;
            height: 245px;
            display: block;
            object-fit: cover;
            background: #f4edce;
        }

        .smile-card figcaption { padding: 13px 7px 0; }
        .smile-card strong {
            display: block;
            margin-bottom: 4px;
            color: var(--green);
            font-family: Georgia, "Times New Roman", serif;
            font-size: 16px;
            font-weight: 400;
        }

        .smile-card span { color: var(--muted); font-size: 11px; }

        .smiles-note {
            margin: 24px 0 0;
            color: var(--muted);
            text-align: center;
            font-size: 10px;
        }

        .details {
            position: relative;
            isolation: isolate;
            padding: 86px 8% 76px;
            overflow: hidden;
            background: #eee7d6;
        }

        .details::before {
            position: absolute;
            top: -165px;
            right: -85px;
            z-index: -1;
            color: rgba(117,99,31,.055);
            content: "B";
            font-family: Georgia, "Times New Roman", serif;
            font-size: 580px;
            line-height: 1;
            pointer-events: none;
        }

        .story-inner { max-width: 1180px; margin: auto; }
        .story-kicker { color: #75631f; font-size: 10px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
        .story-lead {
            max-width: 750px;
            margin: 15px 0 42px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(42px, 6vw, 72px);
            font-weight: 400;
            letter-spacing: -.06em;
            line-height: .98;
        }

        .story-lead em { color: #75631f; font-weight: 400; }
        .story-main { display: grid; grid-template-columns: .82fr 1.18fr; align-items: center; gap: clamp(35px, 7vw, 90px); }
        .story-copy { max-width: 420px; }
        .story-copy h3 { margin: 0 0 15px; font-family: Georgia, "Times New Roman", serif; font-size: clamp(26px, 3vw, 37px); font-weight: 400; letter-spacing: -.04em; line-height: 1.08; }
        .story-copy p { color: #666258; font-size: 14px; line-height: 1.85; }
        .story-copy .story-signoff { margin-top: 21px; color: #75631f; font-family: Georgia, "Times New Roman", serif; font-size: 17px; font-style: italic; }
        .story-actions { margin-top: 27px; display: flex; flex-wrap: wrap; gap: 10px; }
        .story-action {
            min-height: 42px;
            padding: 0 16px;
            display: inline-flex;
            align-items: center;
            gap: 15px;
            border: 1px solid #393620;
            background: #393620;
            color: white;
            font-size: 11px;
            transition: background .2s, color .2s;
        }
        .story-action:hover { background: transparent; color: #393620; }
        .story-action.secondary { background: transparent; color: #393620; }
        .story-action.secondary:hover { background: #393620; color: white; }
        .story-photos {
            min-width: 0;
            min-height: 410px;
            display: grid;
            grid-template-columns: 1.15fr .85fr;
            grid-template-rows: 1fr 1fr;
            gap: 13px;
        }
        .story-photo {
            position: relative;
            min-width: 0;
            min-height: 0;
            overflow: hidden;
            background: #d7cebb;
        }
        .story-photo:first-child { grid-row: 1 / 3; }
        .story-photo img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
        .story-photo:hover img { transform: scale(1.045); }
        .story-photo:first-child img { object-position: 50% 35%; }
        .story-photo::after { position: absolute; inset: 45% 0 0; background: linear-gradient(transparent, rgba(20,22,18,.55)); content: ""; pointer-events: none; }
        .story-photo figcaption { position: absolute; right: 14px; bottom: 13px; left: 14px; z-index: 1; color: white; font-family: Georgia, "Times New Roman", serif; font-size: 15px; }
        .story-values { margin-top: 63px; padding-top: 24px; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(57,54,32,.2); }
        .story-value { padding: 0 25px; }
        .story-value:first-child { padding-left: 0; }
        .story-value + .story-value { border-left: 1px solid rgba(57,54,32,.2); }
        .story-value span { display: block; margin-bottom: 8px; color: #75631f; font-size: 9px; letter-spacing: .15em; text-transform: uppercase; }
        .story-value strong { font-family: Georgia, "Times New Roman", serif; font-size: 19px; font-weight: 400; }

        h2 {
            margin: 16px 0;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(34px, 4vw, 48px);
            font-weight: 400;
            letter-spacing: -.045em;
            line-height: 1.08;
        }

        .product-card {
            padding: 32px;
            border: 1px solid var(--line);
            background: #eeeee7;
        }

        .product-card-art {
            min-height: 190px;
            display: grid;
            place-items: center;
            overflow: hidden;
        }

        .product-card-art .pen { transform: rotate(-28deg) scale(.8); }

        .product-card-footer {
            padding-top: 19px;
            display: flex;
            align-items: end;
            justify-content: space-between;
            border-top: 1px solid #dedfd5;
        }

        .product-card-footer strong {
            display: block;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 17px;
            font-weight: 400;
        }

        .product-card-footer span { color: var(--muted); font-size: 11px; }
        .product-card-footer .price { color: var(--ink); font-size: 18px; }

        .purchase {
            padding: 69px 20px 73px;
            background: var(--green-dark);
            color: white;
            text-align: center;
        }

        .purchase .eyebrow { justify-content: center; color: #f2e39b; }
        .purchase h2 { margin: 15px 0 12px; font-size: clamp(34px, 4vw, 48px); }
        .purchase p { margin-bottom: 22px; color: #eee8cb; font-size: 13px; }
        .purchase .primary-button { background: var(--brand-yellow); color: var(--ink); }
        .purchase .primary-button:hover { background: #e8d47a; }

        footer {
            padding: 23px 7.3%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--muted);
            font-size: 11px;
        }

        .toast {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 5;
            max-width: calc(100vw - 48px);
            padding: 14px 19px;
            border-radius: 3px;
            background: var(--ink);
            box-shadow: 0 9px 28px rgba(0,0,0,.15);
            color: white;
            font-size: 13px;
            opacity: 0;
            pointer-events: none;
            transform: translateY(10px);
            transition: opacity .2s, transform .2s;
        }

        .toast.show { opacity: 1; transform: translateY(0); }

        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            clip-path: inset(50%);
        }

        @media (max-width: 720px) {
            .site-header { min-height: 70px; padding: 0 5%; gap: 14px; }
            .nav-links { gap: 9px; }
            .nav-links a:not(.about-link) { padding: 8px 11px; }
            .hero {
                padding: 57px 7% 48px;
                grid-template-columns: 1fr;
                gap: 0;
            }
            .hero-copy { margin: auto; }
            .hero-art { min-height: 335px; margin-top: 10px; }
            .art-circle { width: min(320px, 80vw); }
            .pen { transform: rotate(-35deg) scale(.84); }
            .benefits { padding: 19px 5%; }
            .benefit { gap: 7px; font-size: 10px; }
            .benefit-icon { font-size: 17px; }
            .details { padding: 66px 7%; }
            .story-main { grid-template-columns: 1fr; gap: 28px; }
